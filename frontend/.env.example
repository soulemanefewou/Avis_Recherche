# ==============================================================================
# Frontend Next.js — variables d'environnement
# Copier ce fichier vers .env.local (développement) ou renseigner
# dans Project Settings → Environment Variables (Vercel).
# ==============================================================================

# ---------- Connexion au backend ----------
# Utilisée côté serveur par next.config.ts pour le proxy /api et /uploads.
# Local : http://127.0.0.1:8000 — Production (Vercel) : https://<service>.onrender.com
API_PROXY_TARGET=http://127.0.0.1:8000

# URL publique de l'API, utilisée côté navigateur (partage social, images).
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Firebase Cloud Messaging (notifications push) ----------
# Console Firebase → Paramètres du projet → Vos applications → Configuration SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Clé Web Push (Firebase Console → Paramètres du projet → Cloud Messaging)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
