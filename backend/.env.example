# ==============================================================================
# Backend Symfony — variables d'environnement
# Copier ce fichier vers .env (local) ou renseigner directement
# dans le dashboard Render (production).
# ==============================================================================

###> symfony/framework-bundle ###
APP_ENV=dev                          # prod sur Render
APP_DEBUG=1                          # 0 sur Render
APP_SECRET=changez-moi-32-caracteres-minimum
APP_SHARE_DIR=var/share

# URL publique de l'API — utilisée pour construire les URLs absolues des photos.
# Local : http://localhost:8000 — Production : https://<votre-service>.onrender.com
APP_BASE_URL=http://localhost:8000

# Proxies de confiance. Local : 127.0.0.1 — Production (Render/Vercel) : *
TRUSTED_PROXIES=127.0.0.1
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# MySQL/MariaDB local :
DATABASE_URL="mysql://root:root123@127.0.0.1:3306/avis_recherche?serverVersion=12.3.2-MariaDB&charset=utf8mb4"
# Render MySQL (exemple) :
# DATABASE_URL="mysql://avis_user:motdepasse@dpg-xxxxx/avis_recherche?serverVersion=8&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
# Générer localement avec : php bin/console lexik:jwt:generate-keypair
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=ma-passphrase-jwt

# --- Production (Render uniquement, via docker/start.sh) ---
# Contenu des clés encodé en base64 (voir DEPLOYMENT.md §A.5) :
# JWT_SECRET_KEY_B64=<base64 du contenu de private.pem>
# JWT_PUBLIC_KEY_B64=<base64 du contenu de public.pem>
###< lexik/jwt-authentication-bundle ###

###> firebase (notifications push — optionnel) ###
FIREBASE_CREDENTIALS=%kernel.project_dir%/var/secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=avis-recherche-app
# Production : JSON du compte de service encodé en base64
# FIREBASE_CREDENTIALS_JSON_B64=<base64 du fichier json>
###< firebase ###
