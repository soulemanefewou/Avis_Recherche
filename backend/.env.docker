# ============================================================
# Valeurs par défaut NON SECRÈTES embarquées dans l'image Docker.
# Les secrets (APP_SECRET, DATABASE_URL, JWT_PASSPHRASE,
# FIREBASE_*) sont fournis par les variables d'environnement
# de la plateforme d'hébergement (Render) qui ont priorité.
# ============================================================

###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=
APP_SHARE_DIR=var/share
# Renseignée automatiquement par start.sh depuis RENDER_EXTERNAL_URL si absente
APP_BASE_URL=http://localhost:8000
# API derrière les proxies Render/Vercel
TRUSTED_PROXIES=*
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Fournie en production par la variable d'environnement DATABASE_URL
DATABASE_URL="mysql://user:password@host:3306/dbname?charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Fourni en production par la variable d'environnement JWT_PASSPHRASE
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> firebase ###
# Écrit par docker/start.sh depuis FIREBASE_CREDENTIALS_JSON_B64
FIREBASE_CREDENTIALS=%kernel.project_dir%/var/secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=avis-recherche-app
###< firebase ###
